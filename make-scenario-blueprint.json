{
  "name": "AI-Powered Email Automation System (Google Sheets + Gemini + Gmail)",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:searchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": "{{connection.google_sheets}}"
      },
      "filter": {
        "name": "Pending Leads Only",
        "conditions": [
          [
            {
              "a": "Draft_Status",
              "o": "text:equal",
              "b": "Pending"
            }
          ]
        ]
      },
      "mapper": {
        "spreadsheetId": "{{spreadsheet_id}}",
        "sheetId": "{{sheet_name}}",
        "range": "A1:M100",
        "hasHeaders": true,
        "maxResults": 10
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "1. Fetch Pending Leads (Google Sheets)"
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google Sheets Connection"
            }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendRequest",
      "version": 3,
      "parameters": {
        "handleErrors": false
      },
      "mapper": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{gemini_api_key}}",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\n  \"system_instruction\": {\n    \"parts\": [\n      {\n        \"text\": \"You are an elite B2B email copywriter. Write highly personalized, concise (<125 words) outreach emails based strictly on the prospect metadata. Respond strictly in valid JSON format with keys: 'subject', 'body_plain', 'body_html', 'reasoning'.\"\n      }\n    ]\n  },\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"Lead Details:\\n- Name: {{1.Recipient_Name}}\\n- Email: {{1.Recipient_Email}}\\n- Company: {{1.Company_Name}}\\n- Role: {{1.Company_Role}}\\n- Industry: {{1.Industry}}\\n- Pain Points: {{1.Context_Pain_Points}}\\n- Offer: {{1.Offer_Angle}}\\n\\nGenerate the tailored cold email in JSON.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.4,\n    \"topP\": 0.95,\n    \"maxOutputTokens\": 1024,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "2. Generate Draft with Gemini API (HTTP)"
        }
      }
    },
    {
      "id": 3,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {
        "type": ""
      },
      "mapper": {
        "json": "{{2.data.candidates[1].content.parts[1].text}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "3. Parse LLM JSON Response"
        }
      }
    },
    {
      "id": 4,
      "module": "google-email:createDraft",
      "version": 2,
      "parameters": {
        "__IMTCONN__": "{{connection.google_email}}"
      },
      "mapper": {
        "to": [
          "{{1.Recipient_Email}}"
        ],
        "subject": "{{3.subject}}",
        "content": "{{3.body_html}}",
        "type": "html"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "4. Create Draft in Gmail"
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Gmail Connection"
            }
          }
        }
      }
    },
    {
      "id": 5,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": "{{connection.google_sheets}}"
      },
      "mapper": {
        "spreadsheetId": "{{spreadsheet_id}}",
        "sheetId": "{{sheet_name}}",
        "row": "{{1.__ROW_NUMBER__}}",
        "values": {
          "Draft_Status": "Draft Created",
          "Generated_Subject": "{{3.subject}}",
          "Generated_Body": "{{3.body_plain}}",
          "Draft_ID": "{{4.id}}",
          "Last_Updated": "{{formatDate(now; \"YYYY-MM-DD HH:mm:ss\")}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "5. Update Row Status in Google Sheets"
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google Sheets Connection"
            }
          }
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "freshVariables": false
    }
  }
}
